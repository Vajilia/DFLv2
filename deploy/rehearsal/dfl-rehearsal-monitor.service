[Unit]
Description=DFLv2 broadcast REHEARSAL monitor (checks the feed against the plan; logs heartbeats and violations; stops the broadcast on a spoiler, resource or monitor failure)
After=dfl-rehearsal.service
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=dflv2
Group=dflv2
Nice=15
MemoryMax=400M
ProtectSystem=strict
ProtectHome=true
# Writes only its own folder (log, evidence, heartbeat, and the TRIPPED latch that makes the daemon pause); the store and the public folder are read-only here.
ReadWritePaths=/srv/dflv2-rehearsal/monitor
ReadOnlyPaths=/srv/dflv2-rehearsal/private /srv/dflv2-rehearsal/feed /opt/dflv2-src
PrivateTmp=true
NoNewPrivileges=true
ExecStart=/usr/bin/python3 -I /opt/dflv2-src/__COMMIT__/tools/rehearsal_check.py watch --root /srv/dflv2-rehearsal/private --public /srv/dflv2-rehearsal/feed --url https://__HOST__ --log /srv/dflv2-rehearsal/monitor/watch.log --evidence /srv/dflv2-rehearsal/monitor/evidence --guard /srv/dflv2-rehearsal/monitor --canary /srv/dflv2-rehearsal/private/store/CANARY.txt --cgroup /sys/fs/cgroup/system.slice/dfl-rehearsal.service --full-every 60 --min-free-gb 6 --max-public-gb 3
Restart=on-failure
RestartSec=10
# exit status 1 means violations were logged: that is a result to read, not a crash to retry. 2 means it could not write its latch: do not retry in a loop either; the
# heartbeat stops and the daemon pauses itself.
RestartPreventExitStatus=1 2

[Install]
WantedBy=multi-user.target
