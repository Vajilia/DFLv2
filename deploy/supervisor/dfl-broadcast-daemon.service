[Unit]
Description=DFLv2 recurring broadcast daemon (the only writer of the public folder; reads the private store; never touches the league)
After=network.target
# three starts in an hour and the unit stays failed: a daemon that keeps dying is not restarted forever
StartLimitIntervalSec=3600
StartLimitBurst=3

# TEMPLATE, NOT INSTALLED. __COMMIT__ is the pinned checkout (/opt/dflv2-src/<commit>), __ROOT__ the builder root, __PUBLIC__ the public folder, __GUARD__ the monitor's folder.
# Unlike the rehearsal unit (deploy/rehearsal/dfl-rehearsal.service): no --deadline (it runs until stopped) and a PER-SEASON public cap instead of a fixed 3 GB, which would stop a
# correct broadcast in season 3 or 4 (tools/publiccap.py).

[Service]
Type=simple
User=dflv2
Group=dflv2
# Measured (tools/measure_combined.py, real engine, 1 CPU, 2 GB group): 32 MB resident, +2 MB over ten seasons (docs/BROADCAST_CONTINUITY.md), 29 MB in its cgroup with page cache.
# 192M is six times what was measured; the rehearsal's 600M was a guess. The monitor trips the guard at 90% of this value (it reads the unit's cgroup), well before a kill.
MemoryMax=192M
# When the kernel kills a process of this unit for going over MemoryMax, stop the whole unit (so no orphan survives) and let Restart= bring it back. Set explicitly: the default is inherited
# from DefaultOOMPolicy= in systemd-system.conf and depends on the distribution. Exercised, with the restart emulated, by tools/oom_check.py (docs/INTEGRATION_CANDIDATE_2026-11-07.md).
OOMPolicy=stop
TasksMax=32
UMask=0022
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__ROOT__/store __PUBLIC__ __GUARD__
ReadOnlyPaths=/opt/dflv2-src
PrivateTmp=true
NoNewPrivileges=true
EnvironmentFile=/etc/dflv2/broadcast.env
ExecStart=/usr/bin/python3 -I /opt/dflv2-src/__COMMIT__/tools/broadcast_run.py run --root __ROOT__ --public __PUBLIC__ --guard __GUARD__ --max-public-gb-per-season ${PUBLIC_GB_PER_SEASON} --public-base-gb ${PUBLIC_BASE_GB} --max-public-ceiling-gb ${PUBLIC_CEILING_GB}
# After the unit stopped and BEFORE Restart= starts it again: if the stop was an OOM kill of any process in this cgroup (the daemon or a child), write the latch (kind oom_kill), the evidence and
# PAUSE, so a restarted daemon starts held. A monitor polling memory.events can miss the event: the restart recreates the cgroup with its counters at zero. A stop that is not an OOM records
# nothing. No "-" prefix: if the recorder fails the unit shows as failed (the hold is made first, and the failure is on stderr). It shares TimeoutStopSec. docs/OOM_INCIDENT_RECORD.md.
ExecStopPost=/usr/bin/python3 -I /opt/dflv2-src/__COMMIT__/tools/broadcast_run.py incident --root __ROOT__ --public __PUBLIC__ --guard __GUARD__ --cgroup /sys/fs/cgroup/system.slice/dfl-broadcast-daemon.service
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# 75 = another daemon holds the lock; 70 = the public cap was exceeded. Neither is cured by restarting; both need a person (docs/INTEGRATION_CANDIDATE_2026-11-07.md, runbook).
RestartPreventExitStatus=75 70

[Install]
WantedBy=multi-user.target
