[Unit]
Description=DFLv2 broadcast SUPERVISOR (prepares the next season ahead of the clock through the builder; never writes the public folder; deletes nothing)
After=network.target
# five starts in an hour and the unit stays failed: a supervisor that keeps dying is not restarted forever (the health file then goes stale and `check` says unknown)
StartLimitIntervalSec=3600
StartLimitBurst=5

# TEMPLATE, NOT INSTALLED. __COMMIT__ is the pinned checkout (/opt/dflv2-src/<commit>), __ROOT__ the builder root (R/league, R/store), __PUBLIC__ the public folder the daemon
# writes. Nothing renders or installs this file yet (docs/UNATTENDED_OPERATION.md, section 8).

[Service]
Type=simple
User=dflv2
Group=dflv2
# The builder it starts runs the engine: keep it behind the broadcast daemon on a one-CPU host (the daemon unit has Nice=10; the daemon matters more).
Nice=15
CPUWeight=20
IOWeight=20
# Measured (tools/measure_combined.py, real engine, 1 CPU, 2 GB group, docs/INTEGRATION_CANDIDATE_2026-11-07.md): the supervisor and the builder step it runs peak at 204 to 217 MB
# of process memory. The unit's cgroup reads 1.2 GB with no limit because the engine's files fill the page cache, which is reclaimable and is not a need. Run under a hard 512M
# it built at the same rate (3.6 events a minute against 3.2), with no kill; the kernel counted 62,532 reclaim hits (failcnt), which is the cache being trimmed, not memory short.
# 768M is the recommendation: 3.5 times the measured process peak and 50% above the validated limit, because a real season's engine step has not run under the unit on the host.
# Together with the daemon (192M) and the monitor (512M) the three limits add to 1472M, under a 2 GB machine, leaving room for the system and Caddy.
MemoryMax=768M
TasksMax=64
UMask=0022
ProtectSystem=strict
ProtectHome=true
# The builder writes the root (league, store, build log, its lock) and the supervisor writes ROOT/supervisor. The public folder is READ-ONLY here: nothing in this unit can write it.
ReadWritePaths=__ROOT__
ReadOnlyPaths=/opt/dflv2-src __PUBLIC__
PrivateTmp=true
NoNewPrivileges=true
EnvironmentFile=/etc/dflv2/broadcast.env
# --floor-gb (FLOOR_BUILD_GB in broadcast.env): keep it above the monitor's floor (FLOOR_BROADCAST_GB) so building stops before the broadcast does. The public-cap flags only REPORT (health: public_cap_near, public_cap_exceeded); the same three numbers as the daemon's and the monitor's, from the same file. --season-gb: about 2.0 GB a season measured (docs/STORAGE_RETENTION.md).
ExecStart=/usr/bin/python3 -I /opt/dflv2-src/__COMMIT__/tools/broadcast_supervisor.py run --root __ROOT__ --public __PUBLIC__ --floor-gb ${FLOOR_BUILD_GB} --step-margin-gb 0.5 --season-gb 2 --interval 30 --public-cap-per-season-gb ${PUBLIC_GB_PER_SEASON} --public-base-gb ${PUBLIC_BASE_GB} --public-ceiling-gb ${PUBLIC_CEILING_GB}
# SIGTERM stops the supervisor and the builder step it is running (the builder resumes from its last complete event); nothing half-built is ever recorded.
KillMode=control-group
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
# 75 = another supervisor holds the lock; 2 = the root has no store. Neither is cured by restarting.
RestartPreventExitStatus=75 2

[Install]
WantedBy=multi-user.target
