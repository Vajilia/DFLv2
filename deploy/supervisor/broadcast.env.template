# TEMPLATE, NOT INSTALLED. One place for the numbers the daemon, the monitor and the supervisor must agree on (docs/INTEGRATION_CANDIDATE_2026-11-07.md, "The public cap").
# /etc/dflv2/broadcast.env, mode 0644, owned by root. The three units read it with EnvironmentFile=; nothing here is a credential.

# The public folder's limit is  BASE + PER_SEASON x (seasons that have been on air),  and never more than CEILING.
#   PER_SEASON: a season publishes 0.78 to 0.95 GB (measured, docs/STORAGE_RETENTION.md); 1.25 is 30% above the largest. Do not set it near the measured value: the unused part
#               of each season carries forward as the slack that hides a small overrun (tools/publiccap.py explains it).
#   BASE:       the fixed part (indexes, the live season's growth before it is complete).
#   CEILING:    the OWNER'S number: what the public folder may ever take on this disk, however many seasons there are. REQUIRED before installing: there is no default, because
#               the right number depends on the disk and on the retention decision (M8). Example only: about 20 GB free, an 8 GB build floor, the public folder's share of a
#               season being about half of it  ->  roughly 6 GB.
PUBLIC_GB_PER_SEASON=1.25
PUBLIC_BASE_GB=0.25
PUBLIC_CEILING_GB=__CEILING_GB__

# Free disk (GB) below which the MONITOR stops the broadcast (a trip), and below which the SUPERVISOR stops building. Keep FLOOR_BUILD above FLOOR_BROADCAST so building stops
# before the broadcast does.
FLOOR_BROADCAST_GB=6
FLOOR_BUILD_GB=8
