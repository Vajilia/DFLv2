# The DFLv2 viewer: a static site plus a static feed. Nothing here runs the league; Caddy only serves files.
# __HOST__ is filled in on the server (never committed): install_staging.sh renders this file for preview.diamondfootballleague.com into
# /etc/caddy/conf.d/dflv2-preview.caddy. HTTPS is Caddy's automatic certificate (it needs the host's DNS to point at this server
# and ports 80 and 443 open). Validate before use:  caddy validate --config /etc/caddy/Caddyfile
# (This file was written without a Caddy binary to hand: it is unvalidated until `caddy validate` has been run on the server.)
__HOST__ {
	encode gzip
	route {
		@writes not method GET HEAD OPTIONS
		respond @writes 405
		header {
			X-Robots-Tag "noindex, nofollow"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		@feed path /feed/*
		@latest path /feed/latest.json /feed/status.json
		# a release file is cached for good only if it EXISTS and can be read. An error answer (403 while a release is half-made or its permissions are wrong,
		# 404 for a pruned or not-yet-existing one) must never be told "immutable": a browser would replay it for a year (found 2026-10-31, first live event).
		# Caddy's `file` matcher is true only for a file it can stat, so those answers keep the plain `no-cache` below.
		@release {
			path /feed/releases/*
			file {
				root /srv/dflv2
			}
		}
		# site files are revalidated each time; the pointer and the status heartbeat are never cached; a published release directory never changes, so it may be cached for long
		header Cache-Control "no-cache"
		header @release Cache-Control "public, max-age=31536000, immutable"
		header @latest Cache-Control "no-store"
		# nothing whose name starts with a dot is ever served (the publisher lock, temporary files)
		@hidden path_regexp (^|/)\.[^/]
		respond @hidden 404
		# two file servers, one root each. (Two `root` lines, the second with a matcher, were tried first and served 404 for every /feed/ file
		# on the real Caddy 2.11 server: found at the first deployment, 2026-10-31.)
		file_server @feed {
			root /srv/dflv2
		}
		file_server {
			root /srv/dflv2/site/current
		}
	}
}
