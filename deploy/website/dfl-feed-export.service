[Unit]
Description=DFLv2 public feed export (reads a copy of the league file, publishes a feed release)
After=network.target

[Service]
Type=oneshot
User=dflv2
Group=dflv2
Nice=15
IOSchedulingClass=idle
MemoryMax=900M
ProtectSystem=strict
# The feed is the only place this unit writes content. The league directory is listed as writable ONLY because SQLite must be able to create its
# "-shm" index file to read a write-ahead-log database at all (tested: as a read-only user it fails with "attempt to write a readonly database"
# whenever no league runner happens to have the file open). The exporter opens the league read-only and writes nothing into the database; it makes a
# private copy and reads that. The league runner MUST run as this same user (dflv2), or a file created here could lock the runner out.
ReadWritePaths=/srv/dflv2/feed /srv/dflv2/league
ReadOnlyPaths=/srv/dflv2/repo
SuccessExitStatus=75
PrivateTmp=true
NoNewPrivileges=true
Environment=BASE=/srv/dflv2
# Every minute the exporter only looks (and rewrites feed/status.json); it builds and publishes a release only when the league has a new committed event.
Environment=EXPORT_ARGS=--skip-if-current
ExecStart=/srv/dflv2/repo/deploy/website/refresh.sh /srv/dflv2/league/league.db
