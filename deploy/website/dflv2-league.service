[Unit]
Description=DFLv2 development league runner (the only process that advances the league)
After=network.target

[Service]
Type=simple
User=dflv2
Group=dflv2
Nice=10
MemoryMax=1200M
ProtectSystem=strict
ReadWritePaths=/srv/dflv2/league
ReadOnlyPaths=/srv/dflv2/repo
PrivateTmp=true
NoNewPrivileges=true
# Pace and limit come from /etc/dflv2/league.env (see run_league.sh). Neither is decided: the owner approves a pace first (docs/DEV_LEAGUE_RUNBOOK.md).
# The unit is installed with the league PAUSED (the file /srv/dflv2/league/PAUSED), so starting this service advances nothing until
# `league_control.py resume`.
ExecStart=/bin/sh /srv/dflv2/repo/deploy/website/run_league.sh
# SIGTERM makes the runner finish the event it is committing and stop; give it time to do that.
TimeoutStopSec=300
Restart=on-failure
RestartSec=60
# 75 = another runner already holds the lock: nothing to restart.
RestartPreventExitStatus=75

[Install]
WantedBy=multi-user.target
